# ── Required (app will not start without these) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only — full DB access, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI features (chatbot, AI game/mission generation) ──────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Payments (Stripe) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One Stripe price per plan and billing interval (create these in Stripe).
STRIPE_PRO_PRICE_ID_MONTHLY=price_...      # Pro, 199 kr / month
STRIPE_PRO_PRICE_ID_YEARLY=price_...       # Pro, 1490 kr / year
STRIPE_STUDIO_PRICE_ID_MONTHLY=price_...   # Studio, 390 kr / month
STRIPE_STUDIO_PRICE_ID_YEARLY=price_...    # Studio, 3490 kr / year
# Legacy single-price vars still work as the yearly fallback if the *_YEARLY
# vars above are unset:
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_STUDIO_PRICE_ID=price_...

# ── Transactional email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key

# ── Optional ───────────────────────────────────────────────────────────────
# Mission translation (falls back to source language if unset)
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
# Canonical URL used in generated links (defaults to https://playgameon.app)
NEXT_PUBLIC_BASE_URL=https://playgameon.app
# Error alerts: an incoming-webhook URL (Slack/Discord/generic) that receives a
# one-line message when an error is captured. If unset, errors are still logged.
ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...
